# Discord Bot Token (required)
# Get this from Discord Developer Portal > Your Application > Bot > Reset Token
TOKEN=your_bot_token_here

# Your Discord Server/Guild ID (required for some features)
# Enable Developer Mode in Discord Settings > Advanced, then right-click your server and copy ID
GUILD_ID=your_server_id_here

# Hugging Face API Key (optional, required for AI features)
# Get this from https://huggingface.co/settings/tokens
HUGGINGFACE_API=your_huggingface_api_key_here

# Bot Command Prefix (optional, defaults to !)
BOT_PREFIX=!
